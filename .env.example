# Public browser configuration only. Never add server or Stripe secret keys.
# API base includes /v1. Configure credentialed CORS for the frontend origin.
VITE_API_BASE_URL=http://localhost:3000/v1
VITE_API_MODE=live
VITE_STRIPE_PUBLISHABLE_KEY=
# Versions must match the API's approved policy configuration before launch.
VITE_PRIVACY_VERSION=
VITE_TERMS_VERSION=
# HTTPS links to the firm's published, reviewed policies. Required for live booking.
VITE_PRIVACY_URL=
VITE_TERMS_URL=
VITE_CANCELLATION_URL=
